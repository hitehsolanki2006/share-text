# Admin password for accessing /admin dashboard
ADMIN_PASSWORD=your-secure-admin-password-here

# Upstash Redis (works everywhere - Vercel, Netlify, etc.)
# Get these from https://console.upstash.com/ after creating a database
KV_REST_API_URL=your-upstash-redis-rest-url
KV_REST_API_TOKEN=your-upstash-redis-rest-token
